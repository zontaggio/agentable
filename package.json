{
  "name": "agentable",
  "version": "0.1.0",
  "description": "Deterministic CLI to assess repository agent readiness with Agentable",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentable": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "npm run clean && node scripts/bundle-frontend.mjs && tsc -p tsconfig.json && node scripts/ensure-bin-permissions.mjs",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('test-dist', { recursive: true, force: true }); fs.rmSync('tsconfig.test.tsbuildinfo', { force: true });\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "benchmark:famous-web": "npm run build && node scripts/generate-famous-benchmark.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "new:criterion": "node scripts/new-criterion.mjs",
    "prepack": "npm run build",
    "prepare": "husky",
    "quality:gates": "node scripts/check-functional-gates.mjs fixtures/quality-gates/functional-benchmark.json",
    "test": "npm run build && npm run check:max-lines && tsc -p tsconfig.test.json && node --test test-dist/*.test.js"
  },
  "keywords": [
    "agent",
    "readiness",
    "cli",
    "audit",
    "code-quality",
    "repository",
    "assessment",
    "ai",
    "github"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentable/cli.git"
  },
  "bugs": {
    "url": "https://github.com/agentable/cli/issues"
  },
  "homepage": "https://github.com/agentable/cli#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "cli-ascii-logo": "^2.0.1"
  }
}
