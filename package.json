{
  "name": "agentable",
  "version": "0.1.0",
  "description": "Deterministic CLI to assess repository agent readiness with Agentable",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentable": "dist/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "clean": "rm -rf dist",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "quality:gates": "node scripts/check-functional-gates.mjs fixtures/quality-gates/functional-benchmark.json",
    "test": "npm run build && npm run check:max-lines && node --test test/**/*.test.js"
  },
  "keywords": [
    "agent",
    "readiness",
    "cli",
    "audit",
    "code-quality",
    "repository",
    "assessment",
    "ai",
    "github"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentable/cli.git"
  },
  "bugs": {
    "url": "https://github.com/agentable/cli/issues"
  },
  "homepage": "https://github.com/agentable/cli#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "cli-ascii-logo": "^2.0.1"
  }
}
